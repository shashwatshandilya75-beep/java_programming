public class Main {
    public static void main(String[] args) {
        
        
        System.out.println("--- 1. For Loop (Counting 1 to 5) ---");
        for (int i = 1; i <= 5; i++) {
            System.out.println("Iteration: " + i);
        }

        
        System.out.println("\n--- 2. While Loop (Counting down from 5) ---");
        int count = 5;
        while (count > 0) {
            System.out.println("Countdown: " + count);
            count--; 
        }

        
        System.out.println("\n--- 3. Do-While Loop (Runs at least once) ---");
        int target = 10;
        do {
            System.out.println("This prints even if the condition is false immediately. Value: " + target);
            target++;
        } while (target < 10); 
        
    }
}
