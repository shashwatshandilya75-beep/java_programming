public class Main {
    public static void main(String[] args) {
        String cleanText = "radar";
        boolean isPalindrome = true;
        
        int left = 0;
        int right = cleanText.length() - 1;
        
        while (left < right) {
            if (cleanText.charAt(left) != cleanText.charAt(right)) {
                isPalindrome = false;
                break;
            }
            left++;
            right--;
        }
        
        System.out.println("Is \"" + cleanText + "\" a palindrome? " + isPalindrome);
    }
}
