
class Vehicle {
    String brand = "Ford";
    
    public void honk() {
        System.out.println("Beep, beep!");
    }
}


class Car extends Vehicle {
    String modelName = "Mustang";
}

public class Main {
    public static void main(String[] args) {
        Car myCar = new Car();

      
        myCar.honk();

       
        System.out.println("Brand: " + myCar.brand + " | Model: " + myCar.modelName);
    }
}
