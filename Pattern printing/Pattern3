import java.util.Scanner;

public class pattern3 {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        System.out.print("Enter value n : ");
        int n = sc.nextInt();

        int row = 0;
        int star = n;

        while (row < n) {

            int col = 0;
    

            while (col < star) {
                
                System.out.print("* ");
                col++;

            }
            System.out.println();
            star--;
            row++;
        }

        sc.close();

    }
}
