import java.util.Scanner;

public class pattern8 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter value n : ");
        int n = sc.nextInt();

        int row = 0;
        int star = n;
        int space = 0;

        while (row < n) {
            int col = 0;
            while (col < space) {
                System.out.print("  ");
                col++;
            }

            int j = 0;
            while (j < star) {
                System.out.print("* ");
                j++;
            }

            System.out.println();
            row++;
            star--;
            space += 2;
        }
        sc.close();
    }
}
