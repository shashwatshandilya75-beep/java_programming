import java.util.Scanner;

public class pattern6 {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        System.out.print("Enter value n : ");
        int n = sc.nextInt();

        int row = 0;

        while (row < n) {

            int col = 0;

            while (col < n) {
                
                if(row == 0|| row == n-1||col == 0|| col == n-1){

                System.out.print("* ");
                }

                else{
                    System.out.print(" ");
                }
               

            
            }
            System.out.println();

        }

        sc.close();

        System.out.println();

    }

}
